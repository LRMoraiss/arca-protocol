# Copie este arquivo para .env e preencha com seus dados
# NUNCA faça commit do arquivo .env no GitHub

# Chave privada da sua carteira MetaMask (sem o prefixo 0x)
PRIVATE_KEY=sua_chave_privada_aqui

# RPC URL da Sepolia — obtenha grátis em https://infura.io ou https://alchemy.com
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/SEU_PROJECT_ID
